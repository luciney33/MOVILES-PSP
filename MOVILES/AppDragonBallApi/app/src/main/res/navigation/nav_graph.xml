<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.appdragonballapi.ui.pantallaHome.HomeFragment"
        android:label="Dragon Ball"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/listaFragment"
        android:name="com.example.appdragonballapi.ui.pantallaListaCharacters.ListaFragment"
        android:label="Personajes"
        tools:layout="@layout/fragment_lista" >
        <action
            android:id="@+id/action_listaFragment_to_detalleFragment"
            app:destination="@id/detalleFragment" />
        <action
            android:id="@+id/action_listaFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_listaFragment_to_crearFragment"
            app:destination="@id/crearFragment" />
        <action
            android:id="@+id/action_listaFragment_to_editarFragment"
            app:destination="@id/editarFragment" />
        <action
            android:id="@+id/action_listaFragment_to_transformacionesFragment"
            app:destination="@id/transformacionesFragment" />
    </fragment>

    <fragment
        android:id="@+id/transformacionesFragment"
        android:name="com.example.appdragonballapi.ui.pantallaTransformaciones.TransformacionesFragment"
        android:label="Transformaciones"
        tools:layout="@layout/fragment_transformaciones" >
        <argument
            android:name="characterId"
            app:argType="integer" />
        <action
            android:id="@+id/action_transformacionesFragment_to_listaFragment"
            app:destination="@id/listaFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.example.appdragonballapi.ui.pantallaDetalleCharacter.DetalleFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_detalle" >
        <argument
            android:name="characterId"
            app:argType="integer" />
        <action
            android:id="@+id/action_detalleFragment_to_listaFragment"
            app:destination="@id/listaFragment" />
        <action
            android:id="@+id/action_detalleFragment_to_editarFragment"
            app:destination="@id/editarFragment" />
    </fragment>
    <fragment
        android:id="@+id/crearFragment"
        android:name="com.example.appdragonballapi.ui.pantallaCrearCharacter.CrearFragment"
        android:label="Crear"
        tools:layout="@layout/fragment_crear" >
        <action
            android:id="@+id/action_crearFragment_to_listaFragment"
            app:destination="@id/listaFragment" />
    </fragment>
    <fragment
        android:id="@+id/editarFragment"
        android:name="com.example.appdragonballapi.ui.pantallaEditarCharacter.EditarFragment"
        android:label="Editar"
        tools:layout="@layout/fragment_editar" >
        <argument
            android:name="characterId"
            app:argType="integer" />
        <action
            android:id="@+id/action_editarFragment_to_listaFragment"
            app:destination="@id/listaFragment" />
        <action
            android:id="@+id/action_editarFragment_to_detalleFragment"
            app:destination="@id/detalleFragment" />
    </fragment>
    <fragment
        android:id="@+id/planetasFragment"
        android:name="com.example.appdragonballapi.ui.pantallaPlanetas.PlanetasFragment"
        android:label="Planetas"
        tools:layout="@layout/fragment_planetas" >
        <action
            android:id="@+id/action_planetasFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>