<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home_fragment">
    <fragment
        android:id="@+id/ListaEntrenamientoFragment"
        android:name="com.example.navigation.ui.menuEntrenamiento.listaEntrenamiento.ListaEntrenamientoFragment"
        android:label="ListaEntrenamientoFragment"
        tools:layout="@layout/fragment_lista_entrenamiento">
        <action
            android:id="@+id/action_listaEntrenamientoFragment_to_detalleEntrenamientoFragment2"
            app:destination="@id/DetalleEntrenamientoFragment" />
        <action
            android:id="@+id/action_listaEntrenamientoFragment_to_sesionEntrenamientoFragment"
            app:destination="@id/SesionEntrenamientoFragment" />
    </fragment>
    <fragment
        android:id="@+id/DetalleEntrenamientoFragment"
        android:name="com.example.navigation.ui.menuEntrenamiento.detalleEntrenamiento.DetalleEntrenamientoFragment"
        android:label="DetalleEntrenamientoFragment"
        tools:layout="@layout/fragment_detalle_entrenamiento">
        <action
            android:id="@+id/action_detalleEntrenamientoFragment_to_listaEntrenamientoFragment"
            app:destination="@id/ListaEntrenamientoFragment" />
    </fragment>
    <fragment
        android:id="@+id/SesionEntrenamientoFragment"
        android:name="com.example.navigation.ui.menuEntrenamiento.sesionEntrenamiento.SesionEntrenamientoFragment"
        android:label="SesionEntrenamientoFragment"
        tools:layout="@layout/fragment_sesion_entrenamiento">
        <action
            android:id="@+id/action_sesionEntrenamientoFragment_to_listaEntrenamientoFragment"
            app:destination="@id/ListaEntrenamientoFragment" />
    </fragment>
    <fragment
        android:id="@+id/ejercicioProgresoFragment"
        android:name="com.example.navigation.ui.menuProgreso.ejercicioProgreso.EjercicioProgresoFragment"
        android:label="fragment_ejercicio_progreso"
        tools:layout="@layout/fragment_ejercicio_progreso" >
        <action
            android:id="@+id/action_ejercicioProgresoFragment_to_registroProgresoFragment"
            app:destination="@id/registroProgresoFragment" />
        <action
            android:id="@+id/action_ejercicioProgresoFragment_to_estadisticaProgresoFragment"
            app:destination="@id/estadisticaProgresoFragment" />
    </fragment>
    <fragment
        android:id="@+id/registroProgresoFragment"
        android:name="com.example.navigation.ui.menuProgreso.registroProgreso.RegistroProgresoFragment"
        android:label="fragment_registro_progreso"
        tools:layout="@layout/fragment_registro_progreso" >
        <action
            android:id="@+id/action_registroProgresoFragment_to_ejercicioProgresoFragment"
            app:destination="@id/ejercicioProgresoFragment" />
    </fragment>
    <fragment
        android:id="@+id/estadisticaProgresoFragment"
        android:name="com.example.navigation.ui.menuProgreso.estadisticaProgreso.EstadisticaProgresoFragment"
        android:label="fragment_estadistica_progreso"
        tools:layout="@layout/fragment_estadistica_progreso" >
        <action
            android:id="@+id/action_estadisticaProgresoFragment_to_ejercicioProgresoFragment"
            app:destination="@id/ejercicioProgresoFragment" />
    </fragment>
    <fragment
        android:id="@+id/home_fragment"
        android:name="com.example.navigation.ui.home.HomeFragment"
        android:label="home_fragment"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/SeleccionarEntrenamientoFragment"
        android:name="com.example.navigation.ui.menuEntrenamiento.sesionEntrenamiento.SesionEntrenamientoFragment"
        android:label="SeleccionarEntrenamientoFragment"
        tools:layout="@layout/fragment_sesion_entrenamiento" />
    <fragment
        android:id="@+id/DetalleSesionFragment"
        android:name="com.example.navigation.ui.sesion.detalleSesion.DetalleSesionFragment"
        android:label="DetalleSesionFragment"
        tools:layout="@layout/fragment_detalle_sesion" />

</navigation>