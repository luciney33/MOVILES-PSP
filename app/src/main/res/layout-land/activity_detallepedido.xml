<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.pantallaDetallePedido.DetallePedidoActivity">


    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/detalle_pedido"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/cajaNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nombre"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/txtNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="@id/cajaNombre"
        app:layout_constraintBottom_toBottomOf="@id/cajaNombre"
        app:layout_constraintStart_toEndOf="@id/cajaNombre"
        app:layout_constraintEnd_toStartOf="@id/cajaEmail"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/cajaEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/email"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/cajaNombre"
        app:layout_constraintStart_toStartOf="@id/guiaCenter"
        app:layout_constraintEnd_toStartOf="@id/textEmail" />

    <EditText
        android:id="@+id/textEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="@id/cajaEmail"
        app:layout_constraintBottom_toBottomOf="@id/cajaEmail"
        app:layout_constraintStart_toEndOf="@id/cajaEmail"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/cajaTelefono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/telefono"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/cajaNombre"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/textTelefono"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="@id/cajaTelefono"
        app:layout_constraintBottom_toBottomOf="@id/cajaTelefono"
        app:layout_constraintStart_toEndOf="@id/cajaTelefono"
        app:layout_constraintEnd_toStartOf="@id/labelMarca"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/labelMarca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txtmarca"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/cajaTelefono"
        app:layout_constraintStart_toStartOf="@id/guiaCenter"
        app:layout_constraintEnd_toStartOf="@id/textMarca" />

    <EditText
        android:id="@+id/textMarca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="@id/labelMarca"
        app:layout_constraintBottom_toBottomOf="@id/labelMarca"
        app:layout_constraintStart_toEndOf="@id/labelMarca"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/labelTalla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txtalla"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/cajaTelefono"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/textTalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="@id/labelTalla"
        app:layout_constraintBottom_toBottomOf="@id/labelTalla"
        app:layout_constraintStart_toEndOf="@id/labelTalla"
        app:layout_constraintEnd_toStartOf="@id/labelObservaciones"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/labelObservaciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/observaciones"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/labelTalla"
        app:layout_constraintStart_toStartOf="@id/guiaCenter"
        app:layout_constraintEnd_toStartOf="@id/textObservaciones" />

    <EditText
        android:id="@+id/textObservaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"
        android:maxLines="2"
        app:layout_constraintTop_toTopOf="@id/labelObservaciones"
        app:layout_constraintBottom_toBottomOf="@id/labelObservaciones"
        app:layout_constraintStart_toEndOf="@id/labelObservaciones"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="4dp" />

    <Button
        android:id="@+id/btnActualizar"
        android:layout_width="167dp"
        android:layout_height="57dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/btn_actualizar"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/btnVolver"
        app:layout_constraintEnd_toStartOf="@id/btnBorrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelTalla" />

    <Button
        android:id="@+id/btnBorrar"
        android:layout_width="188dp"
        android:layout_height="57dp"
        android:layout_marginStart="4dp"
        android:text="@string/btn_borrar"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/btnActualizar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnActualizar"
        app:layout_constraintTop_toTopOf="@id/btnActualizar" />

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_volver"
        android:textSize="11sp"
        android:minHeight="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>