<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/NuevoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Nuevo Usuario"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Nombre"
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:hint="Nombre"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:startIconDrawable="@drawable/lapiz"
        app:layout_constraintEnd_toStartOf="@id/Apellidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/NuevoUsuario"
        android:layout_marginTop="@dimen/margenArriba">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/anchocaja"
            android:layout_height="@dimen/altocaja"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Apellidos"
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:layout_marginTop="@dimen/margenArriba"
        android:hint="Apellidos"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:startIconDrawable="@drawable/lapiz"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/Nombre"
        app:layout_constraintTop_toBottomOf="@id/NuevoUsuario">
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Correo"
        android:layout_width="@dimen/anchoCorreo"
        android:layout_height="@dimen/altocaja"
        android:layout_marginTop="@dimen/margenArriba"
        android:hint="Correo electrónico"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:startIconDrawable="@drawable/outline_alternate_email_24"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintStart_toStartOf="@+id/Nombre"
        app:layout_constraintTop_toBottomOf="@+id/Nombre" >
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="@dimen/anchoCorreo"
        android:layout_height="@dimen/altocaja"
        android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Telefono"
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:layout_marginTop="@dimen/margenArriba"
        android:hint="Teléfono"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:startIconDrawable="@drawable/movil"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/Correo">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/anchocaja"
            android:layout_height="@dimen/altocaja"
            android:inputType="phone"/>
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/FechaNac"
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:layout_marginTop="@dimen/margenArriba"
        android:hint="Fecha nacimiento"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:startIconDrawable="@drawable/calendaripo"
        app:layout_constraintEnd_toEndOf="@+id/Correo"
        app:layout_constraintTop_toBottomOf="@+id/Correo">
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:inputType="date"/>
    </com.google.android.material.textfield.TextInputLayout>


    <TextView
        android:id="@+id/Género"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margenArriba"
        android:text="Género:"
        app:layout_constraintStart_toStartOf="@+id/Telefono"
        app:layout_constraintTop_toBottomOf="@+id/Telefono" />


    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="@dimen/anchoCheck1"
        android:layout_height="@dimen/altoCheck"
        android:text="Mujer"
        app:layout_constraintStart_toEndOf="@+id/Género"
        app:layout_constraintTop_toTopOf="@+id/Género" />

    <CheckBox
        android:id="@+id/checkBox2"
        android:layout_width="@dimen/anchoCheck2"
        android:layout_height="@dimen/altoCheck"
        android:text="Hombre"
        app:layout_constraintStart_toEndOf="@+id/checkBox"
        app:layout_constraintTop_toTopOf="@+id/Género" />

    <CheckBox
        android:id="@+id/checkBox3"
        android:layout_width="@dimen/anchoCheck3"
        android:layout_height="@dimen/altoCheck"
        android:text="Prefiero no decirlo"
        app:layout_constraintStart_toEndOf="@+id/checkBox2"
        app:layout_constraintTop_toTopOf="@+id/Género" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Comentarios"
        android:layout_width="@dimen/anchoCorreo"
        android:layout_height="@dimen/anchocaja2"
        android:layout_marginTop="@dimen/margenArriba"
        android:hint="Comentarios"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:startIconDrawable="@drawable/outline_add_comment_24"
        app:layout_constraintEnd_toEndOf="@+id/checkBox3"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/Género"
        app:layout_constraintTop_toBottomOf="@+id/checkBox2">
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="@dimen/anchoCorreo"
        android:layout_height="@dimen/anchocaja2"
        android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="84dp"
        android:backgroundTint="@color/btnLimColor"
        android:text="Limpiar"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/Comentarios"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />


    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margenBotones"
        android:layout_marginTop="84dp"
        android:backgroundTint="@color/btnGuardarColor"
        android:text="Guardar"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="@+id/Comentarios"
        app:layout_constraintHorizontal_bias="0.743"
        app:layout_constraintStart_toEndOf="@+id/button"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="27dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="37dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="27dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="37dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="@dimen/anchoSig"
        android:layout_height="@dimen/altoSig"
        android:layout_marginTop="@dimen/topbtt"
        android:text="Sig.-->"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />

    <Button
        android:id="@+id/button4"
        android:layout_width="@dimen/anchoAnt"
        android:layout_height="@dimen/altoAnt"
        android:layout_marginTop="@dimen/topbtt"
        android:text="<--Ant."
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />

    <TextView
        android:id="@+id/Numpag"
        android:layout_width="23dp"
        android:layout_height="17dp"
        android:layout_marginTop="28dp"
        android:text="0/0"
        app:layout_constraintEnd_toStartOf="@+id/button2"
        app:layout_constraintHorizontal_bias="0.544"
        app:layout_constraintStart_toEndOf="@+id/button4"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />


</androidx.constraintlayout.widget.ConstraintLayout>