<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".domain.ui.pantallamain.MainActivity">

    <TextView
        android:id="@+id/NuevoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/GuiaTop" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Nombre"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/nombre"
        app:layout_constraintStart_toStartOf="@+id/GuiaIzquierda"
        app:layout_constraintTop_toBottomOf="@+id/NuevoUsuario"
        app:startIconDrawable="@drawable/lapiz">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Apellidos"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Apellidos"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintTop_toBottomOf="@+id/NuevoUsuario"
        app:startIconDrawable="@drawable/lapiz">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Correo"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="@dimen/anchoCorreo"
        android:layout_height="@dimen/altocaja"
        android:hint="Correo electrónico"
        app:layout_constraintEnd_toEndOf="@+id/Apellidos"
        app:layout_constraintStart_toStartOf="@+id/Nombre"
        app:layout_constraintTop_toBottomOf="@+id/Apellidos"
        app:startIconDrawable="@drawable/outline_alternate_email_24">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/anchoCorreo"
            android:layout_height="@dimen/altocaja"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Telefono"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:hint="Teléfono"
        app:layout_constraintStart_toStartOf="@+id/Nombre"
        app:layout_constraintTop_toBottomOf="@+id/Correo"
        app:startIconDrawable="@drawable/movil">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/anchocaja"
            android:layout_height="@dimen/altocaja"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/FechaNac"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="@dimen/anchocaja"
        android:layout_height="@dimen/altocaja"
        android:hint="Fecha nacimiento"
        app:layout_constraintEnd_toEndOf="@+id/Apellidos"
        app:layout_constraintTop_toBottomOf="@+id/Correo"
        app:startIconDrawable="@drawable/calendaripo">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/anchocaja"
            android:layout_height="@dimen/altocaja"
            android:inputType="date" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/Género"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Género:"
        app:layout_constraintStart_toStartOf="@+id/Nombre"
        app:layout_constraintTop_toBottomOf="@+id/Telefono" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="@dimen/anchoCheck1"
        android:layout_height="@dimen/altoCheck"
        android:text="Mujer"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/Género" />

    <CheckBox
        android:id="@+id/checkBox2"
        android:layout_width="@dimen/anchoCheck2"
        android:layout_height="@dimen/altoCheck"
        android:text="Hombre"
        app:layout_constraintStart_toEndOf="@+id/checkBox"
        app:layout_constraintTop_toBottomOf="@+id/Género" />

    <CheckBox
        android:id="@+id/checkBox3"
        android:layout_width="@dimen/anchoCheck3"
        android:layout_height="@dimen/altoCheck"
        android:text="Prefiero no decirlo"
        app:layout_constraintStart_toEndOf="@+id/checkBox2"
        app:layout_constraintTop_toBottomOf="@+id/Género" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/Comentarios"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="@dimen/anchoCorreo"
        android:layout_height="@dimen/anchocaja2"
        android:hint="Comentarios"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintStart_toStartOf="@+id/Nombre"
        app:layout_constraintTop_toBottomOf="@+id/checkBox2"
        app:startIconDrawable="@drawable/outline_add_comment_24">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/anchoCorreo"
            android:layout_height="@dimen/anchocaja2"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/button"
        android:layout_width="@dimen/AncBttInferiores"
        android:layout_height="@dimen/AltBttInferiores"
        android:backgroundTint="@color/btnLimColor"
        android:text="Limpiar"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/guideline8"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/Anterior" />

    <Button
        android:id="@+id/button4"
        android:layout_width="@dimen/AncBttInferiores"
        android:layout_height="@dimen/AltBttInferiores"
        android:backgroundTint="@color/btnActiColor"
        android:text="Actualizar"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/button"
        app:layout_constraintStart_toEndOf="@+id/button" />

    <Button
        android:id="@+id/button5"
        android:layout_width="@dimen/AncBttInferiores"
        android:layout_height="@dimen/AltBttInferiores"
        android:backgroundTint="@color/btBorrarColor"
        android:text="Borrar"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/button"
        app:layout_constraintStart_toEndOf="@+id/button4" />

    <Button
        android:id="@+id/button3"
        android:layout_width="@dimen/AncBttInferiores"
        android:layout_height="@dimen/AltBttInferiores"
        android:backgroundTint="@color/btnGuardarColor"
        android:text="Guardar"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/button"
        app:layout_constraintEnd_toEndOf="@+id/Apellidos"
        app:layout_constraintStart_toEndOf="@+id/button5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GuiaTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GuiaIzquierda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <Button
        android:id="@+id/Siguiente"
        android:layout_width="@dimen/anchoSig"
        android:layout_height="@dimen/altoSig"
        android:layout_marginTop="@dimen/topbtt"
        android:text="--Sig--"
        app:layout_constraintEnd_toEndOf="@+id/Apellidos"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />

    <Button
        android:id="@+id/Anterior"
        android:layout_width="@dimen/anchoAnt"
        android:layout_height="@dimen/altoAnt"
        android:layout_marginTop="@dimen/topbtt"
        android:text="--Ant--"
        app:layout_constraintStart_toStartOf="@+id/Nombre"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />

    <TextView
        android:id="@+id/Numpag"
        android:layout_width="23dp"
        android:layout_height="17dp"
        android:layout_marginTop="28dp"
        android:text="0/0"
        app:layout_constraintEnd_toStartOf="@+id/Siguiente"
        app:layout_constraintStart_toEndOf="@+id/Anterior"
        app:layout_constraintTop_toBottomOf="@+id/Comentarios" />

</androidx.constraintlayout.widget.ConstraintLayout>