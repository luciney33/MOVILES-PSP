### DEBE FUNCIONAR - Registro de nuevo usuario
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "Test123456",
  "email": "testuser@example.com",
  "nombre": "Usuario de Prueba",
  "rol": "USER"
}

### DEBE FUNCIONAR - Activar cuenta
GET http://localhost:8080/api/auth/activar?codigo=CODIGO_DEL_EMAIL


### ========================================
### LOGIN SIN 2FA
### ========================================

### DEBE FUNCIONAR - Login básico (sin 2FA)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "Test123456"
}

### DEBE FUNCIONAR - Listar entrenamientos
GET http://localhost:8080/api/entrenamientos
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJyb2wiOiJVU0VSIiwic3ViIjoidGVzdHVzZXIiLCJpYXQiOjE3Njk5NjU2ODksImV4cCI6MTc2OTk2OTI4OX0.gYZuiE5BnCaZ8Bmnc8HnCGoUl0V4koTaVin1lXhVai58c2FSywMDyHZdPllrjiEtEvSWBvqL9iPDylJnNtJM4A


### ========================================
### FASE 3: HABILITAR 2FA
### ========================================

### DEBE FUNCIONAR - Habilitar 2FA
POST http://localhost:8080/api/auth/2fa/enable
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJyb2wiOiJVU0VSIiwic3ViIjoidGVzdHVzZXIiLCJpYXQiOjE3Njk5NjU2ODksImV4cCI6MTc2OTk2OTI4OX0.gYZuiE5BnCaZ8Bmnc8HnCGoUl0V4koTaVin1lXhVai58c2FSywMDyHZdPllrjiEtEvSWBvqL9iPDylJnNtJM4A

### DEBE FUNCIONAR - Confirmar 2FA con código de Google Authenticator
POST http://localhost:8080/api/auth/2fa/confirm
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJyb2wiOiJVU0VSIiwic3ViIjoidGVzdHVzZXIiLCJpYXQiOjE3Njk5NjU2ODksImV4cCI6MTc2OTk2OTI4OX0.gYZuiE5BnCaZ8Bmnc8HnCGoUl0V4koTaVin1lXhVai58c2FSywMDyHZdPllrjiEtEvSWBvqL9iPDylJnNtJM4A
Content-Type: application/json

{
  "code": "806094"
}


### ========================================
### FASE 4: LOGIN CON 2FA HABILITADO
### ========================================

### DEBE FUNCIONAR - Login credenciales
# Debe retornar HTTP 202 + requires2FA: true
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "Test123456"
}

### DEBE FUNCIONAR - Login verificar código 2FA
# Debe retornar HTTP 200 + accessToken + refreshToken
POST http://localhost:8080/api/auth/2fa/verify
Content-Type: application/json

{
  "username": "testuser",
  "codigo": "922575"
}


### ========================================
### FASE 5: GESTIÓN DE TOKENS
### ========================================

### DEBE FUNCIONAR - Refrescar tokens
POST http://localhost:8080/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJ0ZXN0dXNlciIsImlhdCI6MTc2OTk2NTgzNywiZXhwIjoxNzcwNTcwNjM3fQ.ysV2jeQIGq80wXdJuIMfUbG4ED0KFhvVEwxJ3aQFiyyNHZ_nESUctCS4HqzAYRInByUMTYj8flvAKZvFxofhHA",
